{
  "enabledTools": ["notification.send"],
  "proposalTtlMs": 86400000,
  "approvalTtlMs": 900000,
  "maxInputBytes": 16384,
  "email": {
    "provider": "smtp",
    "from": "quicksilver@your-domain.example",
    "recipients": ["founder@your-domain.example"],
    "smtp": {
      "host": "smtp.your-domain.example",
      "port": 465,
      "usernameEnv": "QUICKSILVER_SMTP_USERNAME",
      "passwordEnv": "QUICKSILVER_SMTP_PASSWORD"
    }
  }
}