{
  "kind": "collectionType",
  "collectionName": "qs_policies",
  "info": { "singularName": "policy", "pluralName": "policies", "displayName": "Policy" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "tenantId": { "type": "string", "required": true, "configurable": false },
    "name": { "type": "string", "required": true },
    "description": { "type": "text" },
    "effect": { "type": "enumeration", "enum": ["allow", "deny", "review"], "required": true },
    "priority": { "type": "integer", "default": 0 },
    "rules": { "type": "json", "required": true },
    "organization": { "type": "relation", "relation": "manyToOne", "target": "plugin::quicksilver.organization", "inversedBy": "policies" },
    "capabilities": { "type": "relation", "relation": "manyToMany", "target": "plugin::quicksilver.capability", "inversedBy": "policies" }
  }
}